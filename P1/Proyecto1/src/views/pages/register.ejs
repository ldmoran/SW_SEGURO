<%- include('../partials/head') %>

<section class="auth-wrap">
  <form class="panel" action="/register" method="POST" autocomplete="off">
    <h1>Crear cuenta segura</h1>
    <p class="muted">Usa una clave robusta (10+ caracteres, mayuscula, minuscula, numero y simbolo).</p>

    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <label for="username">Usuario</label>
    <input id="username" name="username" type="text" maxlength="30" required />

    <label for="email">Correo</label>
    <input id="email" name="email" type="email" maxlength="120" required />

    <label for="password">Contrasena</label>
    <input id="password" name="password" type="password" maxlength="80" required />

    <label for="confirmPassword">Confirmar contrasena</label>
    <input id="confirmPassword" name="confirmPassword" type="password" maxlength="80" required />

    <button class="btn primary" type="submit">Registrarme</button>
  </form>
</section>

<%- include('../partials/foot') %>
