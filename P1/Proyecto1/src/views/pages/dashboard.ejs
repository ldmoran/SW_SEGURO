<%- include('../partials/head') %>

<section class="panel">
  <div class="row-space">
    <h1>Mi panel</h1>
    <a class="btn" href="/albums/new">Solicitar nuevo album</a>
  </div>
  <p class="muted">Aqui controlas tus albums y subidas.</p>
</section>

<section class="grid cards">
  <% if (albums.length === 0) { %>
    <article class="card">
      <h3>Sin albums todavia</h3>
      <p>Solicita un album para iniciar el flujo de revision.</p>
    </article>
  <% } %>

  <% albums.forEach((album) => { %>
    <article class="card">
      <h3><%= album.title %></h3>
      <p><%= album.description %></p>
      <p class="meta">Estado: <strong><%= album.status %></strong> | Privacidad: <strong><%= album.privacy %></strong></p>

      <% if (album.status === 'aprobado') { %>
        <div class="buttons-row" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem;">
          <a href="/albums/<%= album.id %>/upload" class="btn">Subir imagen</a>
          <form method="POST" action="/albums/<%= album.id %>/privacy" style="display: inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="privacy" value="<%= album.privacy === 'publico' ? 'privado' : 'publico' %>">
            <button type="submit" class="btn btn-secondary" style="background-color: #666;">
              Cambiar a <%= album.privacy === 'publico' ? 'privado' : 'público' %>
            </button>
          </form>
        </div>
      <% } %>
    </article>
  <% }) %>
</section>

<%- include('../partials/foot') %>
